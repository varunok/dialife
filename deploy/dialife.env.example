# /etc/dialife.env on the server (root-only, mode 600), read by dialife.service.
# Values with spaces need quotes.

# signs the buttons in push notifications; any long random string (openssl rand -hex 32)
DIALIFE_SECRET=
# where phones reach the API; needed when DIALIFE_SECRET is set
DIALIFE_PUBLIC_URL=https://dialife.example.com
# the family's time zone: times in notifications, the stats day
DIALIFE_TZ=Europe/Kyiv
# what the family calls the phone running xDrip+, shown in the apps and notifications
DIALIFE_UPLOADER_LABEL="Телефон Олі"

# optional push through a self-hosted ntfy
DIALIFE_NTFY_URL=http://127.0.0.1:2586
DIALIFE_NTFY_TOKEN=
# topic:deviceID pairs, one per parent's phone (device ids from "dialife device list")
DIALIFE_NTFY_TARGETS=dialife-dad:2,dialife-mom:3

# optional carb estimates for the food form; with no key nothing about food leaves the server.
# Each comma-separated model is asked at the same time; their answers are combined.
# Gemini (a key from aistudio.google.com, separate from a Gemini app subscription)
DIALIFE_GEMINI_KEY=
DIALIFE_GEMINI_MODEL=gemini-3.5-flash-lite
# and/or any OpenAI-compatible API: OpenAI, OpenRouter, a local Ollama (http://127.0.0.1:11434/v1, no key)
DIALIFE_OPENAI_URL=
DIALIFE_OPENAI_KEY=
DIALIFE_OPENAI_MODEL=
# how long each model may take (a Go duration)
DIALIFE_LLM_TIMEOUT=10s
